{
  "framework": null,
  "cleanUrls": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "launchpad.html", "use": "@vercel/static" },
    { "src": "mcp-protocol.html", "use": "@vercel/static" },
    { "src": "treasury.html", "use": "@vercel/static" },
    { "src": "bridge.html", "use": "@vercel/static" },
    { "src": "deploy_app.html", "use": "@vercel/static" },
    { "src": "css/style.css", "use": "@vercel/static" },
    { "src": "js/app.js", "use": "@vercel/static" },
    { "src": "ethers.umd.min.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/launchpad", "dest": "/launchpad.html" },
    { "src": "/mcp-protocol", "dest": "/mcp-protocol.html" },
    { "src": "/treasury", "dest": "/treasury.html" },
    { "src": "/bridge", "dest": "/bridge.html" },
    { "src": "/deploy", "dest": "/deploy_app.html" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/ethers.umd.min.js", "dest": "/ethers.umd.min.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://rpc.mainnet.chain.robinhood.com https://rpc.testnet.chain.robinhood.com wss://rpc.mainnet.chain.robinhood.com wss://rpc.testnet.chain.robinhood.com wss://*.walletconnect.com wss://*.walletlink.org wss://*.bridge.walletconnect.org;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
