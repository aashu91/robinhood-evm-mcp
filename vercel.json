{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/launchpad", "destination": "/launchpad.html" },
    { "source": "/mcp-protocol", "destination": "/mcp-protocol.html" },
    { "source": "/treasury", "destination": "/treasury.html" },
    { "source": "/bridge", "destination": "/bridge.html" },
    { "source": "/deploy", "destination": "/deploy_app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline' https:; font-src * data:; connect-src * wss: https:;"
        }
      ]
    }
  ]
}
